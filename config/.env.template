# AWS 설정
AWS_REGION=us-east-1
AWS_REGIONS=us-east-1,us-west-2,eu-west-1

# S3 버킷 이름 (분석 결과 저장)
S3_BUCKET_NAME=ebs-optimizer-results

# SQS 설정
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ebs-optimizer-actions

# Slack 설정
# 알림용 웹훅 URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXXXX/BXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX

# Slack 앱 설정 (인터랙티브 기능)
SLACK_BOT_TOKEN=xoxb-XXXXXXXXXXXX-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_SIGNING_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SLACK_VERIFICATION_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX

# Lambda 함수 이름 (분석 함수 호출용)
ANALYZE_LAMBDA_NAME=ebs-analyze-and-notify

# 기타 설정
DEBUG=False

# 유휴 볼륨 감지 기준
IDLE_TIME_THRESHOLD=95
IO_OPS_THRESHOLD=10
THROUGHPUT_THRESHOLD=5242880  # 5MB (바이트 단위)
BURST_BALANCE_THRESHOLD=90
DAYS_TO_CHECK=7

# 과대 프로비저닝 볼륨 감지 기준
DISK_USAGE_THRESHOLD=20
DISK_USAGE_MONTHS=6

# CloudWatch 메트릭 수집 기간 (초)
METRIC_PERIOD=86400  # 1일
